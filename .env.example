# ──────────────────────────────────────────────────────────────
# Provenode — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
# ──────────────────────────────────────────────────────────────

# ── Shelby Protocol ───────────────────────────────────────────
# Get your key at https://shelby.network
# Real mode requires SHELBY_API_KEY + SHELBY_PRIVATE_KEY; without them uploads fail cleanly.
SHELBY_API_KEY=

# shelbynet (real network) | testnet
SHELBY_NETWORK=shelbynet

# shelby (real mode only — demo mode has been removed)
SHELBY_MODE=shelby

# ── Vercel KV (Redis) ─────────────────────────────────────────
# Created automatically when you add a Vercel KV store to the project.
# These are injected by Vercel; set them manually for local dev.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── CORS ─────────────────────────────────────────────────────
# Leave empty to allow all origins, or set to your production URL
# e.g. https://provenode.vercel.app
ALLOWED_ORIGIN=

# ── Vercel (injected automatically — do NOT set these manually) ──
# VERCEL_ENV=production | preview | development
# VERCEL_GIT_COMMIT_SHA=abc1234...
# VERCEL_URL=your-deployment-url.vercel.app

# ── New in v3.1 ───────────────────────────────────────────────
# Resend — email alerts (https://resend.com)
RESEND_API_KEY=

# Alert email address for expiry/tamper/integrity notifications
ALERT_EMAIL=

# Slack bot signing secret (from Slack app settings)
SLACK_SIGNING_SECRET=

# Ed25519 signing key (use SHELBY_PRIVATE_KEY or set a separate one)
# SIGN_KEY=

# Aptos Move contract address (after deploying contract/sources/ModelRegistry.move)
MOVE_CONTRACT_ADDRESS=


# ── React Frontend Auth (Privy + wagmi) ─────────────────────────────────
# Get free at https://dashboard.privy.io
VITE_PRIVY_APP_ID=

# Get free at https://cloud.walletconnect.com
VITE_WC_PROJECT_ID=

# ── API auth (backend) ──────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Protects all mutating /api/* routes. CI/CD and edge
# devices send it as the X-Provenode-Token header.
#
# If this is unset while running on Vercel (or NODE_ENV=production), every
# mutating route returns 503 by design — the API fails CLOSED rather than
# silently accepting anonymous uploads, deploys, deletes, emails and payments.
# For local development only, set ALLOW_OPEN_API=true to restore open mode.
DEPLOY_SECRET=

# Local development escape hatch. NEVER set this in production.
# ALLOW_OPEN_API=true

# REQUIRED for the scheduled jobs (api/crons/*). They send real email and mutate
# model records, so they also fail closed: without this they return 503.
CRON_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Alerts are only ever sent to ALERT_EMAIL, or to an address explicitly listed in
# ALERT_EMAIL_ALLOWLIST (comma-separated) — this prevents the notifications route
# from being used as an open mail relay.
# ALERT_EMAIL=ops@example.com
# ALERT_EMAIL_ALLOWLIST=oncall@example.com,security@example.com

# ── AI agent (chat bot) ────────────────────────────────────────────────────────
# Get a key at https://console.mistral.ai — required for the AI chat bot to work.
MISTRAL_API_KEY=
